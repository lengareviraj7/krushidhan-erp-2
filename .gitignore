# Python virtual environment & cache
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp

# SQLite runtime database & sidecar files (preserve SQL schema/seed templates)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/*.sqlite
data/*.sqlite3
data/*.sqlite-wal
data/*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.pre_restore_raw.bak

# Database backups (legacy & local backup folders)
backups/
data/backups/
.vercel

# Environment & runtime instance secrets (never commit)
.env
.env.*
data/.jwt_secret
*.jwt_secret

# PyInstaller build artifacts & local logs
build/
dist/
*.egg-info/
logs/

# Tauri Rust compiled artifacts & generated schemas
src-tauri/target/
src-tauri/gen/

# Tauri sidecar binaries (build outputs)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
